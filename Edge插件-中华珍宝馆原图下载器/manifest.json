{
  "manifest_version": 3,
  "name": "中华珍宝馆 100% 原图下载器",
  "version": "0.1.0",
  "description": "识别中华珍宝馆大图页面，下载全部高清切片并在本地拼接成 100% 原图。",
  "permissions": ["activeTab", "downloads", "scripting", "storage"],
  "host_permissions": [
    "https://g2.ltfc.net/*",
    "https://cag-ac.ltfc.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "下载 100% 原图"
  },
  "content_scripts": [
    {
      "matches": ["https://g2.ltfc.net/view/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
