@echo off
setlocal
title PS2020 Font Hider
set "PS_FONT_HIDER_SELF=%~f0"

fltmc >nul 2>&1
if not "%errorlevel%"=="0" (
    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath $env:PS_FONT_HIDER_SELF -Verb RunAs"
    exit /b
)

set "PS_FONT_HIDER_TMP=%TEMP%\PSFontHider_%RANDOM%_%RANDOM%.ps1"

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$b=''; foreach($l in [IO.File]::ReadAllLines($env:PS_FONT_HIDER_SELF)){if($l.StartsWith('rem P:')){$b=$b+$l.Substring(6)}}; [IO.File]::WriteAllBytes($env:PS_FONT_HIDER_TMP,[Convert]::FromBase64String($b))"
if not "%errorlevel%"=="0" (
    echo Failed to extract PowerShell payload.
    pause
    exit /b 1
)

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%PS_FONT_HIDER_TMP%"
set "RC=%errorlevel%"
del /f /q "%PS_FONT_HIDER_TMP%" >nul 2>&1
exit /b %RC%

